# ==============================================================================
# Build Arguments
# ==============================================================================
LUNARCORE_REPO=https://github.com/KuraXR/LunarCore-4.6.git
LUNARCORE_BRANCH=main
RESOURCE_REPO=https://gitlab.com/Dimbreath/turnbasedgamedata.git
RESOURCE_BRANCH=main
GENERATE_PROTO=false

# ==============================================================================
# 4.6 Client Design Data (Optional / Recommended for 4.6 clients)
# ==============================================================================
# Path on host containing Persistent/ and StreamingAssets/ manifest subfolders (~5–10 MB total).
# Do NOT copy the full 112 GB StarRail_Data folder; see README for details.
CLIENT_DATA_PATH=./client_data
# Internal path inside container (auto-detected if client_data contains Persistent or StreamingAssets)
CLIENT_DATA_DIR=

# ==============================================================================
# Database Configuration
# ==============================================================================
MONGO_URI=mongodb://mongo:27017
DB_COLLECTION=lunarcore
USE_INTERNAL_MONGO=false

# ==============================================================================
# Network & Ports Configuration
# ==============================================================================
PUBLIC_HOST=127.0.0.1

# HTTP Dispatch Server (TCP)
HTTP_HOST_PORT=80
HTTP_PORT=80
HTTP_PUBLIC_ADDRESS=127.0.0.1
HTTP_PUBLIC_PORT=
HTTP_USE_SSL=false

# Game Server (KCP / UDP)
GAME_HOST_PORT=23301
GAME_PORT=23301
GAME_PUBLIC_ADDRESS=127.0.0.1
GAME_PUBLIC_PORT=

# ==============================================================================
# Server & JVM Options
# ==============================================================================
AUTO_CREATE_ACCOUNT=true
SERVER_LANGUAGE=EN
JAVA_OPTS=-Xms1G -Xmx4G
